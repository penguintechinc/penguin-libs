{
  "name": "@penguintechinc/react-testutils",
  "version": "0.1.3",
  "description": "Shared Vitest + RTL test utilities for PenguinTech React packages",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./setup": {
      "import": "./dist/setup.js",
      "types": "./dist/setup.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "echo 'nothing to clean'",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "penguintech",
    "testing",
    "vitest",
    "react-testing-library",
    "test-utils"
  ],
  "author": "Penguin Tech Inc <dev@penguintech.io>",
  "license": "MIT",
  "homepage": "https://www.penguintech.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penguintechinc/penguin-libs.git",
    "directory": "packages/react-testutils"
  },
  "bugs": {
    "url": "https://github.com/penguintechinc/penguin-libs/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "@testing-library/react": ">=14",
    "@testing-library/jest-dom": ">=6",
    "vitest": ">=1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "18.3.28",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "28.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
