{
  "name": "@penguintechinc/react-aaa",
  "version": "0.1.5",
  "description": "Authentication, Authorization, and Audit library for React applications - OIDC, RBAC, and audit logging",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "react",
    "authentication",
    "authorization",
    "audit",
    "oidc",
    "rbac",
    "typescript",
    "penguintech"
  ],
  "author": "Penguin Tech Inc <dev@penguintech.io>",
  "license": "MIT",
  "homepage": "https://www.penguintech.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penguintechinc/penguin-libs.git",
    "directory": "packages/react-aaa"
  },
  "bugs": {
    "url": "https://github.com/penguintechinc/penguin-libs/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "jose": "5.10.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "18.3.28",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "8.57.1",
    "jsdom": "28.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
