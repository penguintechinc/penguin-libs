package penguin:tools@0.1.0;

/// Outbound HTTP via the host egress guard (SSRF protection, DNS pinning,
/// redirect re-check, host-side secret-ref injection).
interface http {
  record header { name: string, value: string }

  record http-request {
    method: string,
    url: string,
    headers: list<header>,
    body: option<list<u8>>,
    timeout-ms: option<u32>,
  }

  record http-response {
    status: u16,
    headers: list<header>,
    body: list<u8>,
  }

  variant http-error {
    not-granted,
    blocked-destination,
    too-large,
    timeout,
    failed(string),
  }

  send: func(req: http-request) -> result<http-response, http-error>;
}
